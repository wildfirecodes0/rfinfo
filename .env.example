# ───────── Telegram ─────────
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Telegram numeric IDs (comma separated) — get it from @userinfobot
ADMIN_IDS=111111111

# ───────── Admin panel ─────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
SESSION_SECRET=any-long-random-string

# Public HTTPS URL. On Render this is auto-detected (RENDER_EXTERNAL_URL) — leave empty.
# Leave empty locally → bot uses long polling.
PUBLIC_URL=

# ───────── Cloudflare D1 (option A: REST API — simplest) ─────────
CF_ACCOUNT_ID=
CF_API_TOKEN=
D1_DATABASE_ID=

# ───────── Cloudflare D1 (option B: proxy worker — for high traffic) ─────────
# If set, these are used instead of the REST API.
D1_PROXY_URL=
D1_PROXY_SECRET=

# ───────── Cloudflare R2 (backups, broadcast images, welcome banner) ─────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=refer-bot
# Optional: public bucket URL (r2.dev or custom domain) — needed for banner upload
R2_PUBLIC_URL=
# R2_ACCOUNT_ID defaults to CF_ACCOUNT_ID
R2_ACCOUNT_ID=

PORT=3000
